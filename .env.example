# Neon Lakebase Postgres pooled connection string (for app queries)
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Neon Lakebase Postgres direct/unpooled connection string (for Prisma migrations / db push)
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# HMAC secret for signing session cookies (generate a secure random string in production)
SESSION_SECRET="dev-session-secret-change-in-production"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
